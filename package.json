{
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"test": "jest --runInBand",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:backfill-video-thumbnails": "tsx src/db/backfill-video-thumbnails.cli.ts",
		"db:backfill-media-dimensions": "tsx src/db/backfill-media-dimensions.cli.ts",
		"format": "prettier --write \"src/**/*.{ts,json}\" \"drizzle/**/*.json\" \"*.{ts,cjs,json,yml,yaml}\"",
		"format:check": "prettier --check \"src/**/*.{ts,json}\" \"drizzle/**/*.json\" \"*.{ts,cjs,json,yml,yaml}\""
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.888.0",
		"@aws-sdk/s3-request-presigner": "^3.888.0",
		"cors": "^2.8.5",
		"drizzle-orm": "^0.44.7",
		"express": "^5.3.0",
		"multer": "^2.0.2",
		"pg": "^8.16.3",
		"sharp": "^0.34.4",
		"socket.io": "^4.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.0.0",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.15.5",
		"@types/supertest": "^6.0.3",
		"@jest/globals": "^30.2.0",
		"drizzle-kit": "^0.31.4",
		"jest": "^30.2.0",
		"prettier": "^3.6.2",
		"socket.io-client": "^4.8.1",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.5"
	}
}

{
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"test": "jest --runInBand",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"format": "prettier --write \"src/**/*.{ts,json}\" \"drizzle/**/*.json\" \"*.{ts,cjs,json,yml,yaml}\"",
		"format:check": "prettier --check \"src/**/*.{ts,json}\" \"drizzle/**/*.json\" \"*.{ts,cjs,json,yml,yaml}\""
	},
	"dependencies": {
		"drizzle-orm": "^0.44.7",
		"express": "^5.3.0",
		"pg": "^8.16.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.15.5",
		"@jest/globals": "^30.2.0",
		"drizzle-kit": "^0.31.4",
		"jest": "^30.2.0",
		"prettier": "^3.6.2",
		"ts-jest": "^29.4.5"
	}
}
